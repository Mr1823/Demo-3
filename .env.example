# Database Configuration
MONGODB_URI="mongodb+srv://..."

# JWT Authentication
# IMPORTANT: Generate a strong random secret (min 32 characters)
# Use: openssl rand -base64 32
JWT_SECRET="your_jwt_secret_here"

# Environment
NODE_ENV="development"

# Admin Credentials (used during database seeding)
ADMIN_PASSWORD="Buildwith@us"
TEST_USER_PASSWORD="TestUser@123"

# Razorpay Payment Integration (Optional)
RAZORPAY_KEY_ID="rzp_test_YOUR_KEY_HERE"
RAZORPAY_KEY_SECRET="YOUR_SECRET_HERE"

# WhatsApp Cloud API (Optional)
# WHATSAPP_TOKEN=""
# WHATSAPP_PHONE_NUMBER_ID=""
# ADMIN_WHATSAPP_NUMBER=""

# Cloudinary Integration (Unsigned Uploads)
VITE_CLOUDINARY_CLOUD_NAME="your_cloud_name_here"
VITE_CLOUDINARY_UPLOAD_PRESET="your_upload_preset_here"
